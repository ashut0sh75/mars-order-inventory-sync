digraph G {
  rankdir=LR; splines=true; nodesep=0.45; ranksep=0.8; fontname="Arial";
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, fillcolor="#E8F0FB", color="#4A6585"];
  edge [fontname="Arial", fontsize=10, color="#4A6585"];
  labelloc=t; fontsize=18; label="Mars Cosmetics - Order & Inventory Sync (v1)\n ";

  subgraph cluster_ch { label="Sales channels"; style="rounded"; color="#A9B8CC"; fontsize=12;
    WEB [label="Own website\nwebhook"]; NYK [label="Nykaa webhook\n(dupes, out of order)"];
    BLK [label="Blinkit\nwebhook"]; FLK [label="Flipkart\nOrders API (poll only)"]; }

  subgraph cluster_aws { label="AWS ap-south-1: one NestJS codebase, 3 ECS services (api | worker | scheduler)"; style="rounded"; color="#A9B8CC"; fontsize=12;
    ALB [label="ALB (HTTPS)"];
    API [label="api\nverify signature, insert order_events,\nack after commit | Ops API + UI"];
    SCH [label="scheduler (advisory lock + heartbeat)\nFlipkart poll /2 min | Blinkit CSV daily\nBC reconcile /15 min | SWEEPER /30 s\n(re-enqueue PENDING, reclaim expired leases)"];
    RED [label="Redis (ElastiCache)\nBullMQ queues + rate limiters\nrebuildable from PostgreSQL", shape=cylinder, fillcolor="#FFF3D9"];
    PG [label="PostgreSQL (RDS Multi-AZ)\nSOURCE OF TRUTH\nstock, ledger, orders, inbox,\nchannel state, ERP outbox", shape=cylinder, fillcolor="#E6F4EA"];
    ORD [label="worker: ORDER\nnormalize, dedupe, state machine\nRESERVE in one transaction"];
    PUSH [label="worker: STOCK (per channel)\nlag-discounted target, absolute set,\nsingle-flight per (channel, SKU)\nrate limit, backoff"];
    ERPW [label="worker: ERP\nsingle-flight per order\nlookup-before-create, breaker"];
    S3 [label="S3: Blinkit CSV", shape=cylinder, fillcolor="#FFF3D9"];
    CW [label="CloudWatch + Secrets Manager", fillcolor="#EFE8F7"];
  }

  subgraph cluster_out { label="Outbound"; style="rounded"; color="#A9B8CC"; fontsize=12;
    CH [label="Channel stock APIs\nWebsite: own DB | Nykaa: 1 SKU/call, 5 rps\nFlipkart: 50 SKU/call, 10 rps\nBlinkit: daily CSV + REST (~2% timeouts)"];
    BC [label="Business Central (ERP)\ndown 1-2 h most Sundays", fillcolor="#FBE9E7"];
    OPS [label="Ops team", fillcolor="#EFE8F7"]; }

  WEB -> ALB [label="1"]; NYK -> ALB; BLK -> ALB; ALB -> API;
  FLK -> SCH [label="1 poll", dir=both];
  API -> PG [label="1 inbox row"]; SCH -> PG [label="1 inbox row"];
  API -> RED [label="enqueue", style=dashed];
  RED -> ORD [label="2"]; ORD -> PG [label="3 reserve txn", dir=both];
  RED -> PUSH [label="4"]; PUSH -> PG [label="read target / ack", dir=both]; PUSH -> CH [label="5"];
  RED -> ERPW [label="6"]; ERPW -> PG [dir=both]; ERPW -> BC [label="6 create order"];
  SCH -> S3 [label="CSV"]; S3 -> CH [style=dotted];
  BC -> SCH [label="shipments, on-hand", style=dashed];
  OPS -> ALB [label="failed syncs, retry"];
  SCH -> PG [label="sweeper: scan PENDING /\nexpired leases", style=dashed];
}
